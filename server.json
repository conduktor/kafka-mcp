{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.conduktor/kafka-mcp",
  "description": "Read-only Kafka access for AI assistants: topics, consumer groups, schemas, cluster health.",
  "title": "Conduktor",
  "repository": {
    "url": "https://github.com/conduktor/kafka-mcp",
    "source": "github"
  },
  "version": "1.0.0",
  "websiteUrl": "https://www.conduktor.io/mcp",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{console_host}/api/mcp",
      "variables": {
        "console_host": {
          "description": "Your Conduktor Console hostname, e.g. console.acme-corp.com",
          "isRequired": true,
          "format": "string"
        }
      },
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {token}",
          "isRequired": true,
          "variables": {
            "token": {
              "description": "Personal Access Token created in Conduktor Console",
              "isRequired": true,
              "isSecret": true,
              "format": "string"
            }
          }
        }
      ]
    }
  ]
}